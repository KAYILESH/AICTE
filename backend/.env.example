# AICTE Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key     # Server-side only, NEVER expose to frontend

# ── JWT (used to verify Supabase JWT on the backend) ────────────────────────
# Obtain from: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development         # development | production
SECRET_KEY=change-me-to-a-random-256-bit-hex-string
ALLOWED_ORIGINS=http://localhost:3000

# ── File upload constraints ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg

# ── Routing engine ────────────────────────────────────────────────────────────
ROUTING_ENGINE=rule_based   # rule_based | nlp_model
NLP_MODEL_PATH=              # Optional: path to a trained sklearn model .joblib file
ROUTING_CONFIDENCE_THRESHOLD=0.70

# ── Email notifications (optional) ────────────────────────────────────────────
# Leave blank to disable email notifications in the demo
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
